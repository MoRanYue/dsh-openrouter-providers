{
    "name": "dsh-openrouter-providers",
    "version": "1.7.1",
    "description": "OpenRouter Provider List — 从官方目录勾选 OpenRouter 请求使用的提供商，或按模型规则分别限定，并设置量化位数限制，作为 provider.only / provider.order / provider.quantizations 注入；支持图片输入（按宿主的图片预算契约透传）；路由按 baseURL 主机识别，provider 可任意重命名；可选地把请求改经 billion-context 压缩代理。配置由插件自持（$DSH_HOME/openrouter-providers.json），不依赖 settings 命名空间注册，因此同时适配 DSH 0.1.5-rc.1 ~ 0.2.1-rc.2。配置入口：DSH >= 0.1.6-alpha.2 在侧栏「插件」页的组合包页面，更早宿主在「设置 → 插件 → 插件配置」。",
    "type": "module",
    "main": "lib/index.js",
    "icon": "./icon.svg",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/MoRanYue/dsh-openrouter-providers.git"
    },
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./locale/*.json": "./locale/*.json",
        "./package.json": "./package.json"
    },
    "files": [
        "lib",
        "locale/*.json",
        "icon.svg",
        "cordis.patch.yml",
        "README.md",
        "README.en.md",
        "LICENSE"
    ],
    "engines": {
        "node": "\u003e=22",
        "dsh": ">=0.1.5-rc.1 <0.3.0"
    },
    "dsh": {
        "manifestVersion": 1,
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web"
        }
    },
    "peerDependencies": {
        "@deepseek-ai/cordis": "^4.0.1"
    },
    "keywords": [
        "deepseek",
        "harness",
        "dsh",
        "dsh-plugin",
        "openrouter",
        "provider-routing",
        "model-routing",
        "multimodal",
        "billion-context",
        "context-compression"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "license": "MIT"
}